  "info": {
    "_postman_id": "7b53ca4f-3e42-4e1b-a18c-e6e2ec08b468",
    "name": "Incode Omni Face and Liveness Watchlist and AML API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Incode Omni identity verification platform. Onboarding sessions capture and validate government IDs, run face match and passive liveness, perform government-database and watchlist/AML screening, and return scores, OCR data, and images. All calls require an x-api-key, and module calls additionally require the session token in the X-Incode-Hardware-Id header.\n\nContact Support:\n Name: Incode Support",
      "type": "text/plain"
    }
  }
